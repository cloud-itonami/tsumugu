;; com-etzhayyim-tsumugu — Spirit in Physics (Ghost Hacker universe) manga
;; publishing actor. StateGraph containment + governor + append-only ledger
;; (CLAUDE.md "Actors"), self-sovereign kotoba-server identity (no owner
;; hand-off), co-scientist quality loop before any panel/page commits.
{:paths ["src"]

 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/langgraph {:local/root "../../kotoba-lang/langgraph"}
        ;; kami-mangaka-{render,page}-clj were split out of kami-engine and
        ;; renamed to drop the -clj suffix (ADR-2607022800 Phase 2); this repo's
        ;; deps.edn had not been updated to follow, so it still pointed at the
        ;; now-orphaned kami-engine subtree copies. Same fix already applied to
        ;; kami-app-sip's deps.edn (ADR-2607022800 :post-rename-dep-fixes).
        gftd/kami-mangaka-render {:git/url "https://github.com/kotoba-lang/kami-mangaka-render.git"
                                  :sha "2122c2a66c617d05bab21ed423b47b1956f826d3"}
        gftd/kami-mangaka-page   {:git/url "https://github.com/kotoba-lang/kami-mangaka-page.git"
                                  :sha "c416dd96dfefc251d0c66eb87999fb258f7ad315"}}

 :aliases
 {;; :dev used to override langgraph's transitive langchain, because langgraph
  ;; pinned a revision predating the kotoba-conn* read/write-scope split
  ;; (kotoba-lang/langchain#5, merged 8b25753), and the comment here said to
  ;; drop the override once langgraph's own pin advanced past that commit.
  ;; It has: langgraph now pins langchain 52bca7b (2026-08-17), and 8b25753
  ;; (2026-07-01) is an ancestor of it. The override was also inert -- it named
  ;; io.github.com-junkawasaki/langchain-clj, and the repository is
  ;; kotoba-lang/langchain, which langgraph names by the canonical coordinate.
  ;; tools.deps keys on the SYMBOL, so the override matched nothing; measured
  ;; with `kbb -Stree -M:dev:test`, which showed langchain at 52bca7b.
  ;; Renaming the key would not have fixed it either -- it would have made a
  ;; six-week downgrade suddenly live. So the entry is removed, as its own
  ;; comment instructed. The alias itself stays: README and CLAUDE.md invoke
  ;; `-M:dev:run` and `-M:dev:test`.
  :dev {}

  :run  {:main-opts ["-m" "tsumugu.sim"]}

  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts   ["-m" "cognitect.test-runner"]}

  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
